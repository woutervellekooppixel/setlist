{
  "manifestVersion": 5,
  "id": "17b43c5f",
  "name": "Setlist",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/dark.png",
      "scale": [1, 2, 3],
      "theme": ["darkest", "dark"]
    },
    {
      "width": 24,
      "height": 24,
      "path": "icons/light.png",
      "scale": [1, 2, 3],
      "theme": ["lightest", "light"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "Setlist"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2, 3],
          "theme": ["darkest", "dark"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2, 3],
          "theme": ["lightest", "light"]
        }
      ],
      "minimumSize": {
        "width": 300,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 380
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}